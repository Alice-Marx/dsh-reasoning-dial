{
  "name": "dsh-reasoning-dial",
  "version": "0.4.0",
  "type": "module",
  "description": "让任意自定义 API 模型都能声明并选择推理等级：直接编辑 llm-pi-ai 等自定义 provider 目录里每个模型的 reasoningEfforts，把官方那套 Off/Low/Medium/High/XHigh/Max 拨盘扩展到任何自定义 API 模型上。0.3.0 适配 dsh-settings 的 describe()/mutate() 宿主代际；0.4.0 放宽 peer 依赖范围，适配 dsh 0.2.2-rc.5（cordis 4.1 / schemastery 3.19）等最新版宿主。",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "reasoning-effort",
    "llm-pi-ai",
    "custom-api",
    "stepfun",
    "opencode-go"
  ],
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    ".dsh-plugin/index.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "test/plugin.test.mjs",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/plugin.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.1.0",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.19.0",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5 || 0.2.3-alpha.1 || 0.2.3-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5 || 0.2.3-alpha.1 || 0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5 || 0.2.3-alpha.1 || 0.2.3-alpha.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice-Marx/dsh-reasoning-dial.git"
  },
  "homepage": "https://github.com/Alice-Marx/dsh-reasoning-dial#readme",
  "bugs": {
    "url": "https://github.com/Alice-Marx/dsh-reasoning-dial/issues"
  }
}
